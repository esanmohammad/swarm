{
  "name": "swarm-vscode",
  "displayName": "Swarm",
  "description": "VS Code extension for Swarm CLI pipeline orchestration",
  "version": "0.2.0",
  "publisher": "swarm",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "activationEvents": [
    "workspaceContains:.swarm/config.yaml"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "swarmExplorer",
          "title": "Swarm",
          "icon": "$(zap)"
        }
      ]
    },
    "views": {
      "swarmExplorer": [
        {
          "id": "swarmPipeline",
          "name": "Pipeline",
          "contextualTitle": "Swarm Pipeline"
        }
      ]
    },
    "commands": [
      {
        "command": "swarm.connect",
        "title": "Swarm: Connect to Server",
        "icon": "$(plug)"
      },
      {
        "command": "swarm.run",
        "title": "Swarm: Run Pipeline",
        "icon": "$(play)"
      },
      {
        "command": "swarm.runStage",
        "title": "Swarm: Run Pipeline Stage",
        "icon": "$(play-circle)"
      },
      {
        "command": "swarm.runMayday",
        "title": "Swarm: Run MayDay",
        "icon": "$(flame)"
      },
      {
        "command": "swarm.spawnAgent",
        "title": "Swarm: Spawn Agent",
        "icon": "$(person-add)"
      },
      {
        "command": "swarm.showOutput",
        "title": "Swarm: Show Agent Output",
        "icon": "$(output)"
      },
      {
        "command": "swarm.showAgentOutput",
        "title": "Show Agent Output",
        "icon": "$(output)"
      },
      {
        "command": "swarm.killAgent",
        "title": "Swarm: Kill Agent",
        "icon": "$(stop)"
      },
      {
        "command": "swarm.refreshTree",
        "title": "Swarm: Refresh Pipeline",
        "icon": "$(refresh)"
      },
      {
        "command": "swarm.showDiff",
        "title": "Swarm: Show Artifact Diff",
        "icon": "$(diff)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "swarm.run",
          "when": "view == swarmPipeline && swarm.connected",
          "group": "navigation@1"
        },
        {
          "command": "swarm.refreshTree",
          "when": "view == swarmPipeline",
          "group": "navigation@2"
        },
        {
          "command": "swarm.spawnAgent",
          "when": "view == swarmPipeline && swarm.connected",
          "group": "navigation@3"
        },
        {
          "command": "swarm.showDiff",
          "when": "view == swarmPipeline && swarm.connected",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "swarm.killAgent",
          "when": "view == swarmPipeline && viewItem == runningAgent",
          "group": "inline"
        },
        {
          "command": "swarm.showAgentOutput",
          "when": "view == swarmPipeline && viewItem =~ /^(agent|runningAgent)$/",
          "group": "inline"
        },
        {
          "command": "swarm.runStage",
          "when": "view == swarmPipeline && viewItem == stage && swarm.connected",
          "group": "1_actions"
        },
        {
          "command": "swarm.killAgent",
          "when": "view == swarmPipeline && viewItem == runningAgent",
          "group": "2_lifecycle"
        }
      ]
    },
    "configuration": {
      "title": "Swarm",
      "properties": {
        "swarm.wsHost": {
          "type": "string",
          "default": "localhost",
          "description": "Swarm WebSocket server host"
        },
        "swarm.wsPort": {
          "type": "number",
          "default": 3847,
          "description": "Swarm WebSocket server port"
        },
        "swarm.autoConnect": {
          "type": "boolean",
          "default": true,
          "description": "Automatically connect when .swarm/ directory is detected"
        }
      }
    }
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w"
  },
  "dependencies": {
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/ws": "^8.5.10",
    "typescript": "^5.3.0"
  }
}
