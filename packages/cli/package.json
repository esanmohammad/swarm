{
  "name": "swarm-pipeline",
  "version": "0.1.0",
  "description": "AI builds your feature while you watch — orchestrate Claude Code agents through a structured 5-stage pipeline",
  "type": "module",
  "license": "MIT",
  "author": "Esan Mohammad",
  "repository": {
    "type": "git",
    "url": "https://github.com/esanmohammad/swarm"
  },
  "homepage": "https://github.com/esanmohammad/swarm#readme",
  "keywords": [
    "claude",
    "ai",
    "agent",
    "pipeline",
    "cli",
    "code-generation",
    "orchestration",
    "vibe-coding",
    "anthropic"
  ],
  "bin": {
    "swarm": "./dist/bin/swarm.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx bin/swarm.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && cd ../.. && npm run build:dashboard && cd packages/cli && node scripts/bundle-assets.js"
  },
  "dependencies": {
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "open": "^10.1.0",
    "ora": "^8.2.0",
    "uuid": "^11.1.0",
    "ws": "^8.18.0",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
